/* ===== A5 动效层：关键帧 ===== */

/* 签筒摇签八拍 */
@keyframes shake {
  0%,100% { transform:rotate(0); }
  15% { transform:rotate(-6deg); }
  30% { transform:rotate(6.4deg); }
  45% { transform:rotate(-5deg); }
  60% { transform:rotate(4.4deg); }
  75% { transform:rotate(-2.6deg); }
}
@keyframes stickShake {
  0%,100% { transform:translateX(-50%) translateX(var(--dx)) rotate(var(--ang)); }
  20% { transform:translateX(-50%) translateX(var(--dx)) rotate(calc(var(--ang) - 11deg)); }
  40% { transform:translateX(-50%) translateX(var(--dx)) rotate(calc(var(--ang) + 11deg)); }
  60% { transform:translateX(-50%) translateX(var(--dx)) rotate(calc(var(--ang) - 7deg)); }
  80% { transform:translateX(-50%) translateX(var(--dx)) rotate(calc(var(--ang) + 7deg)); }
}

/* 铜钱抛掷 */
@keyframes coinToss {
  0% { transform:translateY(0) rotateY(0); }
  50% { transform:translateY(-60rpx) rotateY(540deg); }
  100% { transform:translateY(0) rotateY(1080deg); }
}

/* 焚香火星闪烁 */
@keyframes ember {
  0%,100% { opacity:1; transform:translateX(-50%) scale(1); }
  50% { opacity:.6; transform:translateX(-50%) scale(.8); }
}

/* 焚香烟雾上升 */
@keyframes smoke {
  0% { opacity:.15; transform:translateX(-50%) translateY(10rpx) scale(.9); }
  50% { opacity:.5; transform:translateX(-56rpx) translateY(-12rpx) scale(1.05); }
  100% { opacity:.15; transform:translateX(-50%) translateY(10rpx) scale(.9); }
}

/* 星轨逐点出现 */
@keyframes starIn {
  from { opacity:0; }
  to { opacity:1; }
}

/* 星轨连线绘制 */
@keyframes drawSeg {
  to { stroke-dashoffset:0; }
}

/* 页面入场 */
@keyframes pageIn {
  from { opacity:0; transform:translateY(18rpx); }
  to { opacity:1; transform:none; }
}

/* 弹窗淡入 */
@keyframes modalIn {
  from { opacity:0; transform:scale(.92); }
  to { opacity:1; transform:scale(1); }
}

/* 星星闪烁 */
@keyframes twinkle {
  0%,100% { opacity:.3; }
  50% { opacity:.8; }
}
