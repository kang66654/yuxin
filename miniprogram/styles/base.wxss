.ring .const {
  position:absolute;
  top:0;
  right:0;
  bottom:0;
  left:0;
  width:100%;
  height:100%;
  opacity:0;
  pointer-events:none;
  transition:opacity .3s;
}
.ring .const.on {
  opacity:1;
}
.ring .const .chalo {
  fill:var(--gold-soft-a16);
  opacity:1;
}
.ring .const .cstar {
  fill:var(--starcore);
  opacity:1;
  filter:drop-shadow(0 0 9.8rpx var(--gold-soft-a90));
}
.ring .const .cline {
  fill:none;
  stroke:var(--moon-glow);
  stroke-width:1.1;
  stroke-dasharray:100;
  stroke-dashoffset:0;
}
.ring.trace .const.on .cstar,.ring.trace .const.on .chalo {
  opacity:0;
  animation:starIn .5s ease forwards;
  animation-delay:var(--d,0s);
}
.ring.trace .const.on .cline {
  stroke-dashoffset:100;
  animation:drawSeg .45s linear forwards;
  animation-delay:var(--d,0s);
}
.ring .cname {
