  transform:translateX(-50%);
  width:299rpx;
  height:49rpx;
  border-radius:24.5rpx;
  background:linear-gradient(180deg,var(--rim),var(--woodmid) 55%,var(--wooddeep));
  box-shadow:0 7.4rpx 19.6rpx var(--black-a35),inset 0 2.5rpx 0 var(--hilite-a80);
  z-index:2;
}
.qian-tube .t-mouth {
  position:absolute;
  left:50%;
  bottom:343.1rpx;
  transform:translateX(-50%);
  width:264.7rpx;
  height:44.1rpx;
  border-radius:50%;
  background:radial-gradient(ellipse at 50% 40%,var(--mouth),var(--mouthdark) 78%);
  box-shadow:inset 0 7.4rpx 19.6rpx var(--black-a85),0 2.5rpx 0 var(--gold-soft-a40);
  z-index:5;
}
.qian-tube .q-stick {
  position:absolute;
  bottom:367.6rpx;
  left:50%;
  width:34.3rpx;
  height:142.2rpx;
  border-radius:7.4rpx;
  overflow:hidden;
  background:linear-gradient(180deg,var(--sticklight),var(--stickshade));
  box-shadow:0 2.5rpx 4.9rpx var(--black-a50),inset 0 -7.4rpx 12.3rpx var(--woodshadow-a22);
  z-index:3;
  transition:none;
  --dx:0;
  --ang:0deg;
  --d:0ms;
  transform:translateX(-50%) translateX(var(--dx)) rotate(var(--ang));
  transform-origin:bottom center;
  will-change:transform;
}
.qian-tube .q-stick::before {
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:41.7rpx;
  border-radius:7.4rpx 7.4rpx 0 0;
  background:linear-gradient(180deg,var(--stickglow),var(--stickline));
}
.qian-tube .q-stick::after {
  content:attr(data-n);
  position:absolute;
  top:51.5rpx;
  left:0;
  right:0;
  text-align:center;
  font-family:"Songti SC","STZhongsong",serif;
  font-size:21rpx;
  font-weight:700;
  color:var(--stickedge);
  letter-spacing:0;
}
.qian-tube.shake {
  animation:shake .62s ease;
}
.qian-tube.shake .q-stick {
  animation:stickShake .62s ease-in-out;
  animation-delay:var(--d);
}
.qian-tube .q-stick.rise {
  transform:translateX(-50%) translateX(var(--dx)) translateY(-93.1rpx) rotate(calc(var(--ang) * .4))!important;
  transition:transform .38s cubic-bezier(.2,.9,.3,1);
  z-index:9!important;
}
.qian-tube .q-stick.out {
  z-index:9!important;
  box-shadow:0 14.7rpx 34.3rpx var(--black-a55);
}
.qian-tube .q-stick.riseout {
  transform:translateX(-50%) translateX(var(--dx)) translateY(-313.7rpx) rotate(calc(var(--ang) + 10deg))!important;
  opacity:0;
  transition:transform .5s ease-in,opacity .45s ease;
}

/* ===== 悬签直出：中签拔起上浮，微光放大 ===== */
.qian-tube.tube-dim {
  opacity:.55;
  transition:opacity .5s ease;
}
.qian-tube .q-stick.stick-hide {
  opacity:0;
}
.hover-stick {
  position:absolute;
  left:50%;
  top:30rpx;
  transform:translateX(-50%);
  display:flex;
  flex-direction:column;
  align-items:center;
  animation:hoverRise .7s cubic-bezier(.2,.85,.3,1) forwards;
  z-index:20;
}
.hover-stick .hs-body {
  width:36rpx;
  height:180rpx;
  border-radius:8rpx;
  background:linear-gradient(180deg,var(--sticklight),var(--stickshade));
  box-shadow:0 6rpx 16rpx var(--black-a50);
  display:flex;
  flex-direction:column;
  align-items:center;
  overflow:hidden;
}
.hover-stick .hs-tip {
  width:100%;
  height:44rpx;
  border-radius:8rpx 8rpx 0 0;
  background:linear-gradient(180deg,var(--stickglow),var(--stickline));
}
.hover-stick .hs-char {
  margin-top:14rpx;
  font-family:"Songti SC","STZhongsong",serif;
  font-size:24rpx;
  font-weight:700;
  color:var(--stickedge);
}
.hover-stick .hs-glow {
  position:absolute;
  top:20rpx;
  left:50%;
  transform:translateX(-50%);
  width:140rpx;
  height:140rpx;
  border-radius:50%;
  background:radial-gradient(circle,rgba(232,207,151,.55),rgba(232,207,151,0) 70%);
  animation:glowPulse 1.2s ease-in-out infinite;
}
@keyframes hoverRise {
  0% { opacity:0; transform:translateX(-50%) translateY(60rpx) scale(.85); }
  100% { opacity:1; transform:translateX(-50%) translateY(0) scale(1); }
}
@keyframes glowPulse {
  0%,100% { opacity:.5; transform:translateX(-50%) scale(1); }
  50% { opacity:1; transform:translateX(-50%) scale(1.15); }
}

/* ===== 结果态签子：红绳竖签，竖排四字箴言 ===== */
