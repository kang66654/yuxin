}
.qian-tube {
  position:relative;
  width:367.6rpx;
  height:436.3rpx;
  margin:0 auto;
}
.qian-tube .t-base {
  position:absolute;
  left:50%;
  bottom:-9.8rpx;
  transform:translateX(-50%);
