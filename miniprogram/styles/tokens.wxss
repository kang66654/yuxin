@keyframes pageIn {
  from {
    opacity: 0;
    transform: translateY(9px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes ember {
  0%,100% {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }
  50% {
    opacity: .6;
    transform: translateX(-50%) scale(.8);
  }
}

@keyframes smoke {
  0% {
    opacity: .15;
    transform: translateX(-50%) translateY(10px) scale(.9);
  }
  50% {
    opacity: .5;
    transform: translateX(-56%) translateY(-6px) scale(1.05);
  }
  100% {
    opacity: .15;
    transform: translateX(-50%) translateY(10px) scale(.9);
  }
}

@keyframes drawSeg {
  to {
    stroke-dashoffset: 0;
  }
}

@keyframes starIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes shake {
  0%,100% {
    transform: rotate(0);
  }
  15% {
    transform: rotate(-6deg);
  }
  30% {
    transform: rotate(6.4deg);
  }
  45% {
    transform: rotate(-5deg);
  }
  60% {
    transform: rotate(4.4deg);
  }
  75% {
    transform: rotate(-2.6deg);
  }
}

@keyframes stickShake {
  0%,100% {
    transform: translateX(-50%) translateX(var(--dx)) rotate(var(--ang));
  }
  20% {
    transform: translateX(-50%) translateX(var(--dx)) rotate(calc(var(--ang) - 11deg));
  }
  40% {
    transform: translateX(-50%) translateX(var(--dx)) rotate(calc(var(--ang) + 11deg));
  }
  60% {
    transform: translateX(-50%) translateX(var(--dx)) rotate(calc(var(--ang) - 7deg));
  }
  80% {
    transform: translateX(-50%) translateX(var(--dx)) rotate(calc(var(--ang) + 7deg));
  }
}

@keyframes coinToss {
  0% {
    transform: translateY(0) rotate(0);
  }
  40% {
    transform: translateY(-16px) rotate(160deg);
  }
  70% {
    transform: translateY(2px) rotate(300deg);
  }
  100% {
    transform: translateY(0) rotate(360deg);
  }
}

