%3E%3Cg%20fill%3D%22%23FFF8E7%22%3E%3Ccircle%20cx%3D%2230%22%20cy%3D%22152%22%20r%3D%222.6%22%2F%3E%3Ccircle%20cx%3D%2270%22%20cy%3D%22114%22%20r%3D%223.4%22%2F%3E%3Ccircle%20cx%3D%22118%22%20cy%3D%22128%22%20r%3D%222.8%22%2F%3E%3Ccircle%20cx%3D%22150%22%20cy%3D%2288%22%20r%3D%224.2%22%2F%3E%3Ccircle%20cx%3D%22198%22%20cy%3D%22102%22%20r%3D%223%22%2F%3E%3Ccircle%20cx%3D%22226%22%20cy%3D%22144%22%20r%3D%222.6%22%2F%3E%3Ccircle%20cx%3D%22128%22%20cy%3D%22178%22%20r%3D%222.4%22%2F%3E%3Ccircle%20cx%3D%22172%22%20cy%3D%22198%22%20r%3D%222.2%22%2F%3E%3C%2Fg%3E%3Cg%20fill%3D%22%23C9CFF0%22%3E%3Ccircle%20cx%3D%2216%22%20cy%3D%2260%22%20r%3D%221%22%20opacity%3D%220.4%22%2F%3E%3Ccircle%20cx%3D%22250%22%20cy%3D%2240%22%20r%3D%221.1%22%20opacity%3D%220.45%22%2F%3E%3Ccircle%20cx%3D%22266%22%20cy%3D%2290%22%20r%3D%220.9%22%20opacity%3D%220.35%22%2F%3E%3Ccircle%20cx%3D%22240%22%20cy%3D%22180%22%20r%3D%221%22%20opacity%3D%220.4%22%2F%3E%3Ccircle%20cx%3D%2240%22%20cy%3D%22212%22%20r%3D%221%22%20opacity%3D%220.35%22%2F%3E%3Ccircle%20cx%3D%2296%22%20cy%3D%2236%22%20r%3D%220.9%22%20opacity%3D%220.35%22%2F%3E%3Ccircle%20cx%3D%22196%22%20cy%3D%22222%22%20r%3D%220.9%22%20opacity%3D%220.3%22%2F%3E%3Ccircle%20cx%3D%22258%22%20cy%3D%22140%22%20r%3D%220.8%22%20opacity%3D%220.35%22%2F%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%22108%22%20r%3D%220.9%22%20opacity%3D%220.3%22%2F%3E%3Ccircle%20cx%3D%22212%22%20cy%3D%2252%22%20r%3D%220.9%22%20opacity%3D%220.35%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E") center / contain no-repeat;
}
.ss-const--anim { animation: constGlow 2.6s ease-in-out infinite; }
@keyframes constGlow {
  0%, 100% { opacity: .55; }
  50% { opacity: 1; }
}
/* 流星 */
.ss-meteor {
  position: absolute;
  left: 372rpx; top: -30rpx;
  width: 261rpx; height: 149rpx;
  background: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22140%22%20height%3D%2280%22%20viewBox%3D%220%200%20140%2080%22%20fill%3D%22none%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22mt%22%20x1%3D%221%22%20y1%3D%220%22%20x2%3D%220%22%20y2%3D%221%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%23FFF8E7%22%20stop-opacity%3D%220.85%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23FFF8E7%22%20stop-opacity%3D%220%22%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Cpath%20d%3D%22M134%206%20L52%2062%22%20stroke%3D%22url%28%23mt%29%22%20stroke-width%3D%221.6%22%20stroke-linecap%3D%22round%22%2F%3E%3Ccircle%20cx%3D%22134%22%20cy%3D%226%22%20r%3D%221.8%22%20fill%3D%22%23FFF8E7%22%2F%3E%3C%2Fsvg%3E") center / contain no-repeat;
  opacity: .9;
}
/* 地平线山影 */
.ss-mount {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 120rpx;
  background: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22402%22%20height%3D%2280%22%20viewBox%3D%220%200%20402%2080%22%20fill%3D%22none%22%3E%3Cpath%20d%3D%22M0%2040%20C60%2020%20122%2044%20192%2030%20C262%2016%20322%2040%20402%2022%20L402%2080%20L0%2080%20Z%22%20fill%3D%22%230D0E22%22%20fill-opacity%3D%220.5%22%2F%3E%3Cpath%20d%3D%22M0%2058%20C80%2040%20152%2062%20232%2050%20C302%2040%20352%2056%20402%2046%20L402%2080%20L0%2080%20Z%22%20fill%3D%22%23060714%22%20fill-opacity%3D%220.6%22%2F%3E%3C%2Fsvg%3E") center bottom / 100% 100% no-repeat;
}
/* 状态提示胶囊 */
.ss-pill {
  position: absolute;
  left: 50%;
  bottom: 74rpx;
  transform: translateX(-50%);
  height: 60rpx;
  padding: 0 30rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  background: rgba(13,14,34,.8);
  border: 1rpx solid rgba(232,201,138,.2);
  font-family: "Songti SC", "SimSun", serif;
  font-size: 24rpx;
  color: #E8C98A;
  letter-spacing: .12em;
}

/* ---------- 按钮 ---------- */
.star-main {
  margin-top: 18rpx;
  height: 106rpx;
  border-radius: 53rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F2DFA8, #D9B96A);
  color: #3A2A10;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: .08em;
  box-shadow: 0 16rpx 44rpx rgba(232,201,138,.34);
  transition: transform .12s;
}
.star-main:active { transform: scale(.97); }

.star-sub-btn {
  margin-top: 18rpx;
  height: 82rpx;
  border-radius: 41rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,.045);
  border: 1rpx solid rgba(255,255,255,.12);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #C9CFE8;
  letter-spacing: .04em;
}
.star-sub-btn:active { opacity: .82; }

.star-foot {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #6A7194;
  letter-spacing: .04em;
}

/* ---------- 各态通用 ---------- */
.star-start, .star-anim {
  position: relative;
  z-index: 1;
}
.star-start { flex: 1; display: flex; flex-direction: column; }
.star-center { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.star-start .pbtn:first-of-type { margin-top: auto; }

.star-anim {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* ---- 结果卡文字：与问事页统一 ---- */
.res-inner { padding: 8rpx 28rpx 24rpx; }
.res-line {
  font-family: 'Songti SC', 'Source Han Serif SC', serif;
  font-size: 36rpx; font-weight: 700; color: var(--ink);
  line-height: 1.45; letter-spacing: .02em;
}
.res-sub2 {
  font-family: 'Songti SC', serif;
  font-size: 28rpx; font-weight: 600; letter-spacing: .08em;
  color: var(--gold-deep, #b8924a);
  margin-top: 8rpx;
}
.res-read {
  font-size: 26rpx; color: var(--ink-faint, #7a7263);
  margin: 16rpx 0 20rpx; line-height: 1.7;
}
.res-yj { display: flex; flex-wrap: wrap; gap: 16rpx 28rpx; }
.yj-item { display: flex; align-items: center; }
.yj-tag {
  width: 44rpx; height: 44rpx; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Songti SC', serif; font-size: 26rpx; font-weight: 700;
  margin-right: 12rpx;
}
.yj-val { font-size: 27rpx; font-weight: 600; }
.yj-good .yj-tag { background: rgba(94, 122, 92, .16); color: var(--green, #5e7a5c); }
.yj-good .yj-val { color: var(--green, #5e7a5c); }
.yj-bad .yj-tag { background: rgba(168, 69, 46, .14); color: var(--red, #a8452e); }
.yj-bad .yj-val { color: var(--red, #a8452e); }
