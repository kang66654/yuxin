/* 仪式库 + 焚香/观星 overlay：原型 L549–735 行内样式换算 */

.lib-sub { font-size: 29.4rpx; color: var(--nav-text); margin: 4.9rpx 0 9.8rpx; }
.lib-go { margin-top: 29.4rpx; }

.lv-wrap { margin-top: 31.9rpx; }
.lv-t { font-size: 29.4rpx; color: var(--nav-text); margin-bottom: 17.1rpx; }
.lv-note { font-size: 27rpx; color: var(--gold-soft); margin-top: 14.7rpx; line-height: 1.6; }

/* 焚香 */
.incense-start { flex: 1; display: flex; flex-direction: column; }
.incense-box-wrap { flex: 1; display: flex; align-items: center; justify-content: center; }
.incense-start .pbtn:first-of-type { margin-top: auto; }
.btn-gap { margin-top: 19.6rpx; }
.incense-mood { padding: 31.9rpx 34.3rpx; }
.im-hint { font-size: 29.4rpx; color: var(--ink-faint); margin-bottom: 14.7rpx; }
.im-text { font-size: 34.3rpx; color: var(--ink-soft); line-height: 1.6; }
.im-textarea { width:100%; font-size: 34.3rpx; color: var(--ink-soft); line-height: 1.6; min-height:60rpx; }
.ib-title {
  font-family: 'Songti SC', 'Source Han Serif SC', serif;
  font-size: 32rpx; color: var(--gold-soft); letter-spacing: .14em; margin-top: 19.6rpx; text-align: center;
}
.ib-sub { font-size: 27rpx; color: var(--nav-text); margin-top: 9.8rpx; text-align: center; }
.anim-title {
  font-family: 'Songti SC', 'Source Han Serif SC', serif;
  font-size: 36rpx; color: var(--gold-soft); letter-spacing: .18em; margin-top: 39rpx;
}
.anim-sub { font-size: 29.4rpx; color: var(--nav-text); margin-top: 14.7rpx; }
.anim-t { color: var(--gold-soft); font-weight: 700; }
.anim-back { margin-top: auto; }

/* ================= 观星 · 星图仪式（按设计稿重绘）
   402px 设计宽度 → 750rpx，1px ≈ 1.866rpx
   夜色 #1D1E3C→#12132B→#0A0B1A，金 #E8C98A / 亮金 #F2DFA8 ================= */

/* 场景底：固定层，只在 star 态出现 */
.star-scene {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(175deg, #1D1E3C 0%, #12132B 45%, #0A0B1A 100%);
}
/* 斜向银河带 */
.star-scene::before {
  content: "";
  position: absolute;
  left: -170rpx; top: 430rpx;
  width: 1120rpx; height: 355rpx;
  transform: rotate(-24deg);
  background: linear-gradient(90deg, rgba(214,220,255,0) 0%, rgba(214,220,255,.055) 35%, rgba(232,201,138,.05) 55%, rgba(214,220,255,0) 100%);
  filter: blur(4rpx);
}
/* 顶部紫晕 */
.star-scene::after {
  content: "";
  position: absolute;
  left: 50%; top: -300rpx;
  width: 1120rpx; height: 820rpx;
  margin-left: -560rpx;
  background: radial-gradient(ellipse at 50% 50%, rgba(110,100,196,.16), rgba(110,100,196,0) 68%);
}

.star-layer {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* ---------- 标题区 ---------- */
.star-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 8rpx;
}
.sh-l { display: flex; align-items: baseline; }
/* 标题/副题直接复用全局 .page-hd .pt / .ps（宋体 44rpx + 金色副题），与其他界面一致 */
.sh-vip {
  display: flex;
  align-items: center;
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: 26rpx;
  background: rgba(255,255,255,.05);
  border: 1rpx solid rgba(232,201,138,.28);
}
.sh-vip-ic { font-size: 20rpx; color: #E8C98A; line-height: 1; margin-right: 8rpx; }
.sh-vip-tx { font-size: 22rpx; color: #E8C98A; letter-spacing: .02em; line-height: 1; }

.star-sub {
  font-size: 24rpx;
  color: #6F769A;
  letter-spacing: .06em;
  margin-top: 6rpx;
}

/* ---------- 心情胶囊（一行五枚）---------- */
.star-chips {
  display: flex;
  gap: 17rpx;
  margin: 26rpx 0 0;
}
.star-chip {
  flex: 1;
  height: 67rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8B90AC;
  letter-spacing: .14em;
  background: rgba(255,255,255,.05);
  border: 1rpx solid rgba(255,255,255,.10);
  transition: all .18s;
}
.star-chip.on {
  background: linear-gradient(90deg, #F2DFA8, #D9B96A);
  color: #3A2A10;
  font-weight: 700;
  border-color: transparent;
  box-shadow: 0 8rpx 26rpx rgba(232,201,138,.28);
}

/* 自定义心情输入 */
.star-custom {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  align-items: center;
}
.star-custom-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: rgba(255,255,255,.06);
  border: 1rpx solid rgba(255,255,255,.12);
  font-size: 26rpx;
  color: #E8E4D8;
}
.star-custom-btn {
  flex: 0 0 auto;
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #F2DFA8, #D9B96A);
  color: #3A2A10;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 星盘舞台 ---------- */
.star-stage {
  position: relative;
  flex: 1;
  min-height: 760rpx;
  margin-top: 14rpx;
}
.ss-core { position: relative; width: 600rpx; height: 600rpx; }
.star-stage .ss-core {
  position: absolute;
  left: 50%;
  top: 0;
  margin-left: -300rpx;
}

/* 刻度星盘环 */
.ss-ring {
  position: absolute;
  left: 0; top: 0;
  width: 600rpx; height: 600rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(232,201,138,.20);
}
.ss-ring::before {
  content: "";
  position: absolute;
  left: 35rpx; top: 35rpx; right: 35rpx; bottom: 35rpx;
  border-radius: 50%;
  border: 1rpx dashed rgba(232,201,138,.26);
}
.ss-ring::after {
  content: "";
  position: absolute;
  left: 84rpx; top: 84rpx; right: 84rpx; bottom: 84rpx;
  border-radius: 50%;
  border: 1rpx dashed rgba(232,201,138,.14);
}
/* 四方位菱形刻度 */
.ss-mark {
  position: absolute;
  width: 11rpx; height: 11rpx;
  background: rgba(232,201,138,.55);
  transform: rotate(45deg);
}
.ss-m-n { left: 50%; top: -6rpx; margin-left: -5.5rpx; }
.ss-m-s { left: 50%; bottom: -6rpx; margin-left: -5.5rpx; }
.ss-m-e { top: 50%; right: -6rpx; margin-top: -5.5rpx; }
.ss-m-w { top: 50%; left: -6rpx; margin-top: -5.5rpx; }

/* 主星座 */
