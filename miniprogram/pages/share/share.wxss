
/* rec-row for mt/records */
.rec-row { display:flex; align-items:center; justify-content:space-between; padding:24.5rpx 0; border-bottom:1rpx solid var(--card-line); }
.rec-row:last-child { border-bottom:none; }
.rec-t { font-size:31rpx; color:var(--ink); }
.rec-s { font-size:27rpx; color:var(--ink-faint); margin-top:9.8rpx; line-height:1.5; }
.rec-btn { width:auto !important; padding:9.8rpx 24.5rpx !important; font-size:27rpx; flex:0 0 auto; }

/* fav-row */
.fav-row { padding:24.5rpx 0; border-bottom:1rpx solid var(--card-line); }
.fav-row:last-child { border-bottom:none; }
.fav-q { font-family:"Songti SC",serif; font-size:34.3rpx; color:var(--ink); line-height:1.5; }
.fav-s { font-size:27rpx; color:var(--ink-faint); margin-top:9.8rpx; }

/* lv-card */
.lv-card { background:var(--tint-bg); border:1rpx solid var(--tint-line); border-radius:24.5rpx; padding:24.5rpx; margin-bottom:14.7rpx; }
.lv-card.cur { background:linear-gradient(135deg,var(--btn-a),var(--btn-b)); border:none; }
.lv-n { font-size:31rpx; color:var(--ink); font-weight:700; }
.lv-card.cur .lv-n { color:var(--btn-text); }
.lv-d { font-size:27rpx; color:var(--gold-soft); margin-top:4.9rpx; }
.lv-card.cur .lv-d { color:var(--btn-text); }
.lv-note { font-size:25.5rpx; color:var(--nav-text); margin-top:22rpx; text-align:center; line-height:1.6; }

/* vip */
.vip-title { font-family:"Songti SC",serif; font-size:39rpx; font-weight:700; color:var(--ink); }
.vip-sub { font-size:29.4rpx; color:var(--ink-faint); margin:7.4rpx 0 22rpx; }
.vip-plans { display:flex; gap:14.7rpx; }
.plan { flex:1; text-align:center; border:1rpx solid var(--tint-line); border-radius:24.5rpx; padding:22rpx 9.8rpx; background:var(--tint-bg); }
.plan.cur { border-color:var(--gold); background:linear-gradient(135deg,var(--btn-a),var(--btn-b)); }
.p-price { font-size:36.8rpx; font-weight:700; color:var(--gold-soft); }
.plan.cur .p-price { color:var(--btn-text); }
.p-desc { font-size:25.5rpx; color:var(--nav-text); margin-top:4.9rpx; }
.plan.cur .p-desc { color:var(--btn-text); }
.vip-row { display:flex; gap:14.7rpx; margin-top:15.7rpx; }
.vip-fine { font-size:25.5rpx; color:var(--nav-text); margin-top:14.7rpx; text-align:center; }

/* share */
.sh-tag {
  font-size: 24rpx; color: var(--gold-soft);
  background: rgba(43,38,32,0.6); border: 1rpx solid rgba(216,180,106,0.5);
  border-radius: 999rpx; padding: 8rpx 22rpx; white-space: nowrap;
}

.sh-card {
  flex: 1 0 auto; display:flex; align-items:center; justify-content:center;
}
.sh-card-inner {
  width: 100%;
  background: rgba(20,20,32,0.55);
  border: 1.5rpx solid var(--gold);
  border-radius: 28rpx;
  padding: 30rpx 28rpx 24rpx;
  box-sizing: border-box;
}
.sh-card-inner.vip {
  background: rgba(14,14,26,0.8);
  border: 2rpx solid var(--gold-deep);
  box-shadow: 0 0 24rpx rgba(216,180,106,0.25), inset 0 0 0 6rpx rgba(216,180,106,0.08);
}
.sh-ribbon {
  text-align:center; font-family:"Songti SC",serif;
  font-size: 24rpx; color: var(--gold-soft); letter-spacing: .1em; margin-bottom: 12rpx;
}
.sh-card-title {
  text-align:center; font-family:"Songti SC",serif;
  font-size: 30rpx; font-weight:700; color: var(--gold-soft);
  letter-spacing: .12em; margin-bottom: 24rpx;
}
.sh-paper {
  position: relative; background: linear-gradient(160deg,#F7F2E7,#EFE7D3);
  border-radius: 18rpx; padding: 44rpx 40rpx 40rpx; overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.25);
}
.sh-watermark {
  position:absolute; right: 24rpx; top: 50%; transform: translateY(-50%);
  font-family:"Songti SC",serif; font-size: 150rpx; color: rgba(180,141,74,0.12);
  line-height: 1; pointer-events:none;
}
.sh-ptext { position: relative; z-index: 1; }
.sh-read {
  position: relative; z-index: 1;
  font-size: 26rpx; color: var(--cardink); line-height: 1.7;
  margin-top: 18rpx; letter-spacing: .02em;
}
.sh-line1, .sh-line2 {
  font-family:"Songti SC",serif; font-weight:700; color: var(--ink);
  font-size: 52rpx; line-height: 1.5; letter-spacing: .04em;
}
.sh-vert {
  position: absolute; right: 30rpx; top: 44rpx; z-index:1;
  writing-mode: vertical-rl; display:flex; gap: 16rpx;
  font-family:"Songti SC",serif; font-size: 22rpx; color: var(--cardink); letter-spacing: .2em;
}
.sh-yj { display:flex; gap: 24rpx; margin-top: 34rpx; position: relative; z-index:1; }
.yj-item { display:flex; align-items:center; gap: 10rpx; }
.yj-tag {
  font-size: 22rpx; padding: 2rpx 10rpx; border-radius: 6rpx; color:#fff;
}
.yj-good .yj-tag { background: var(--green); }
.yj-bad .yj-tag { background: var(--red); }
.yj-good .yj-val { color: var(--ink-faint); font-size: 26rpx; }
.yj-bad .yj-val { color: var(--red); font-size: 26rpx; }
.sh-meta {
  margin: 22rpx 0 0 116rpx; font-size: 24rpx; color: var(--nav-text);
  letter-spacing: .05em; position: relative; z-index:1;
}
.sh-qr {
  position: absolute; left: 28rpx; bottom: 24rpx; z-index: 2;
  display: flex; flex-direction: column; align-items: center;
}
.sh-qr-img { width: 84rpx; height: 84rpx; border-radius: 8rpx; background:#fff; padding:4rpx; box-sizing:border-box; }
.sh-qr-tip { font-size: 18rpx; color: var(--cardink); margin-top: 6rpx; letter-spacing: .1em; }
.sh-seal {
  position:absolute; right: 30rpx; bottom: 30rpx; z-index:1;
  width: 52rpx; height: 52rpx; border-radius: 8rpx;
  background: var(--red); color: #F5F1E8;
  font-family:"Songti SC",serif; font-size: 30rpx;
  display:flex; align-items:center; justify-content:center;
}
.sh-seal.gold { background: var(--gold-deep); }
.sh-card-foot {
  text-align:center; font-size: 22rpx; color: var(--nav-text);
  margin-top: 20rpx; letter-spacing: .04em;
}
.sh-foot { font-size:25.5rpx; color:var(--nav-text); text-align:center; margin-top:15.7rpx; margin-bottom:10rpx; }
.sh-btn-first { margin-top:auto !important; }
.sh-btn-second { margin-top:16rpx !important; }

/* 隐藏导出画布 */
.save-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 600px;
  height: 900px;
}

/* intro */
.ob-label { font-size:32rpx; color:var(--gold-soft); margin:34.3rpx 0 14.7rpx; }
.ob-input { background:var(--tint-bg); border:1rpx solid var(--tint-line); border-radius:24.5rpx; padding:22rpx 29.4rpx; font-size:32rpx; color:var(--ink); }
.ob-hint { font-size:25.5rpx; color:var(--ink-faint); margin-top:14.7rpx; line-height:1.6; }
.ob-date { display:flex; gap:14.7rpx; align-items:center; }
.ob-date .ob-input { flex:1; }
.ob-u { font-size:27rpx; color:var(--nav-text); }
.ob-mbti { margin-top:14.7rpx; }
.ob-mrow { display:flex; align-items:center; gap:14.7rpx; margin-bottom:14.7rpx; }
.ob-k { font-size:29.4rpx; color:var(--nav-text); width:98rpx; }
.ob-foot { margin-top:auto; padding-top:39.2rpx; }
.ob-dots { display:flex; gap:9.8rpx; justify-content:center; margin-bottom:22rpx; }
.dot { width:14.7rpx; height:14.7rpx; border-radius:50%; background:var(--tint-line); }
.dot.on { background:var(--gold); }
.ob-btns { display:flex; gap:14.7rpx; justify-content:center; }
.ob-skip { display:block; text-align:center; font-size:25.5rpx; color:var(--nav-text); margin-top:22rpx; }



/* per-record card spacing */
.rec-card { margin-bottom:14.7rpx; }
.rec-card:last-of-type { margin-bottom:0; }
.rec-card .rec-row { padding:0; border-bottom:none; }
.rec-card .fav-row { padding:0; border-bottom:none; }

/* pin button to bottom */
.pin-bottom { margin-top:auto !important; }
